@startuml
left to right direction

title Gérer les comptes utilisateurs

actor "Utilisateur" as Utilisateur
actor "Client" as Client
actor "Mécanicien" as Mecanicien
actor "Administrateur" as Admin

Client --|> Utilisateur
Mecanicien --|> Utilisateur
Admin --|> Utilisateur

rectangle "Gérer les comptes utilisateurs" {

  usecase "Créer un compte" as UC1

  usecase "Modifier son compte" as UC2

  usecase "Supprimer son compte" as UC3

  usecase "Rechercher un utilisateur" as UC4

  usecase "Modifier un compte utilisateur" as UC5

  usecase "Désactiver un compte" as UC6
}

Utilisateur --> UC1
Utilisateur --> UC2
Utilisateur --> UC3

Admin --> UC4
Admin --> UC5
Admin --> UC6

@enduml
